EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 first and adds ~2s to every request.
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=llama3.2:3b
LLM_TIMEOUT=60

CHUNK_WORDS=250
MAX_CACHED_QUESTIONS=500
MAX_UPLOAD_MB=5

TOP_K=3
MIN_SCORE=0.45
MAX_HISTORY=3

# Query, error and index log lines older than this are deleted when the backend starts. 0 keeps them forever.
LOG_RETENTION_DAYS=30
